---
import '@fontsource/poppins/latin-300.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-700.css';
// Hashed URLs of the body (300) and heading (500) faces, so they can be preloaded.
import poppins300 from '@fontsource/poppins/files/poppins-latin-300-normal.woff2?url';
import poppins500 from '@fontsource/poppins/files/poppins-latin-500-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/images/portrait.jpg';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href, basePath } from '../lib/paths';

interface Props {
  /** Page title; omitted on the home page so the tab reads just the site name. */
  title?: string;
  description?: string;
  /** Absolute URL of a social-card image; defaults to the portrait. */
  ogImage?: string;
  ogImageAlt?: string;
}

const SITE_NAME = 'Daniel Campos Zamora';
const SITE_DESCRIPTION = 'HCI PhD student';

const props = Astro.props;
const { title, description = SITE_DESCRIPTION } = props;
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;

// Social card: a page's own image, or the portrait.
const defaultOg = await getImage({ src: portrait, width: 1200, format: 'jpg' });
const ogImage = props.ogImage ?? (Astro.site ? new URL(defaultOg.src, Astro.site).href : undefined);
const ogImageAlt = props.ogImageAlt ?? (props.ogImage ? undefined : 'TODO alt text (portrait.jpg)');

// Canonical URL: Astro.url.pathname may or may not already carry the base.
const path = Astro.url.pathname;
const canonicalPath = path.startsWith(basePath) ? path : href(path);
const canonical = Astro.site ? new URL(canonicalPath, Astro.site).href : undefined;

// Keep the staging site (GitHub Pages at github.io) out of search engines.
const isStaging = Astro.site?.hostname.endsWith('github.io') ?? false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {/* Apply the stored theme before first paint. Inline on purpose: no external JS. */}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch {
        /* storage unavailable: follow the system */
      }
    </script>
    <link rel="preload" as="font" type="font/woff2" href={poppins500} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={poppins300} crossorigin />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {isStaging && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={props.ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
