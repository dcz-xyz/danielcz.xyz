---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { altText } from '../lib/alt';
import { href } from '../lib/paths';
import { authorRuns, doiLabel } from '../lib/publications';

/**
 * One publication: the first page of the PDF as a clickable thumbnail (as on
 * the Makeability Lab publications list), venue tag, title, authors with
 * Daniel's name in bold and equal-contribution markers, and link pills.
 */
interface Props {
  publication: CollectionEntry<'publications'>;
}
const { publication } = Astro.props;
const { title, authors, equalContribution, venue, thumbnail, thumbnailAlt, links } =
  publication.data;

const pills = [
  links.pdf ? { label: 'PDF', url: href(links.pdf) } : null,
  links.doi ? { label: doiLabel(links.doi), url: links.doi } : null,
  links.video ? { label: 'Video', url: links.video } : null,
  links.code ? { label: 'Code', url: links.code } : null,
].filter((p): p is { label: string; url: string } => p !== null);

const runs = authorRuns(authors, equalContribution);
const pdf = links.pdf ? href(links.pdf) : undefined;
const alt = altText(thumbnailAlt, `publications/${publication.id}: thumbnail`);
---

<article class="pub" id={`pub-${publication.id}`}>
  {pdf ? (
    <a class="pub__thumb pub__thumb--link" href={pdf} aria-label={`Open the PDF of ${title}`}>
      <Picture
        src={thumbnail}
        alt={alt}
        width={560}
        widths={[280, 560]}
        sizes="(min-width: 640px) 140px, 104px"
        formats={['avif']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
      />
    </a>
  ) : (
    <div class="pub__thumb">
      <Picture
        src={thumbnail}
        alt={alt}
        width={560}
        widths={[280, 560]}
        sizes="(min-width: 640px) 140px, 104px"
        formats={['avif']}
        fallbackFormat="webp"
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
  <div class="pub__body">
    <p class="pub__venue">{venue}</p>
    <h3 class="pub__title">{title}</h3>
    <p class="pub__authors">
      {runs.map((a) => (
        <Fragment>
          {a.me ? <strong>{a.name}</strong> : a.name}
          {a.star && <span class="pub__star">*</span>}
          {a.separator}
        </Fragment>
      ))}
    </p>
    {equalContribution.length > 0 && <p class="pub__note">* Equal contribution</p>}
    {pills.length > 0 && (
      <ul class="pub__links" aria-label={`Links for ${title}`}>
        {pills.map((p) => (
          <li>
            <a class="pill" href={p.url}>
              {p.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  .pub {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: var(--space-3) var(--space-4);
    align-items: start;
  }

  /* The first page of the paper, as a small page tile (US letter proportions). */
  .pub__thumb {
    display: block;
    aspect-ratio: 8.5 / 11;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: #ffffff;
    transition:
      box-shadow var(--dur-fast) var(--ease),
      transform var(--dur-fast) var(--ease),
      border-color var(--dur-fast) var(--ease);
  }

  .pub__thumb--link:hover,
  .pub__thumb--link:focus-visible {
    border-color: var(--muted);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--fg) 14%, transparent);
    transform: translateY(-2px);
  }

  /* <Picture> wraps the image in <picture>; size it so the image can fill the box. */
  .pub__thumb :global(picture) {
    height: 100%;
  }

  .pub__thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .pub__venue {
    margin: 0 0 var(--space-1);
    color: var(--muted);
    font-size: var(--fs-xs);
    font-weight: var(--fw-regular);
    line-height: var(--lh-tight);
  }

  .pub__title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    text-wrap: pretty;
  }

  .pub__authors {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  .pub__authors strong {
    color: var(--fg);
    font-weight: var(--fw-medium);
  }

  .pub__star {
    font-weight: var(--fw-medium);
  }

  .pub__note {
    margin: var(--space-1) 0 0;
    color: var(--muted);
    font-size: var(--fs-xs);
  }

  .pub__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .pub {
      grid-template-columns: 140px minmax(0, 1fr);
    }
  }
</style>
