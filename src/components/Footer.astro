---
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__copy">Copyright © Daniel Campos Zamora</p>
    <SocialLinks variant="plain" />
    <ThemeToggle />
  </div>
</footer>

<style>
  .site-footer {
    /* The band is dark in both themes; re-point the tokens so children adapt. */
    --bg: var(--band-bg);
    --fg: var(--band-fg);
    --muted: var(--band-muted);
    --accent: var(--band-fg);

    margin-top: auto;
    padding-block: var(--space-6);
    background: var(--bg);
    color: var(--fg);
    font-size: var(--fs-sm);
    text-align: center;
  }

  .site-footer__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
  }

  .site-footer__copy {
    margin: 0;
  }
</style>
