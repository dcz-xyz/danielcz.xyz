---
import { Picture } from 'astro:assets';
import portrait from '../../assets/images/portrait.jpg';
import SocialLinks from '../SocialLinks.astro';
import { href } from '../../lib/paths';
import { CV_PATH, PORTRAIT_ALT } from '../../lib/site';

// Copy and links are verbatim from content-source/about.md.
const contact = 'mailto:danielcz@cs.uw.edu?bcc=danieljcampos19%40gmail.com&subject=Hello!%20';
---

<section id="about" class="section about" aria-labelledby="about-heading">
  <span id="about-me" class="anchor-alias" aria-hidden="true"></span>
  <div class="container about__inner">
    <div class="about__portrait rise">
      <Picture
        src={portrait}
        alt={PORTRAIT_ALT}
        width={960}
        widths={[320, 640, 960]}
        sizes="(min-width: 900px) 360px, (min-width: 640px) 280px, 200px"
        formats={['avif']}
        fallbackFormat="webp"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
    <div class="about__text rise">
      <h1 id="about-heading" class="about__heading">
        Hello 👋
      </h1>
      <div class="prose">
        <p>
          I’m a sixth-year PhD student at the University of Washington in the School of Computer
          Science &amp; Engineering as a member of the
          <a href="https://makeabilitylab.cs.washington.edu/">Makeability Lab</a> advised by
          <a href="https://jonfroehlich.github.io/">Jon E. Froehlich</a>. My research combines
          fabrication, robotics, and sensing to create novel tangible and embodied interactions that
          bridge the physical and digital world. I build systems that leverage material affordances
          at different scales—from individual objects to environments—to enrich the spectrum of
          touch, spatial, and kinesthetic senses.
        </p>
        <p>
          Prior to doing my PhD, I was a Disney Imagineer with
          <a href="https://www.disneyresearch.com/">Disney Research</a> working in robotics, HCI,
          and augmented reality advised by{' '}
          <a href="https://ece.illinois.edu/about/directory/faculty/joohyung">Dr. Joohyung Kim</a>{' '}
          and <a href="https://www.katsuyamane.com/">Dr. Katsu Yamane</a>. I completed my
          undergraduate studies at Carnegie Mellon University where I worked with{' '}
          <a href="https://alimomeni.net/ali">Dr. Ali Momeni</a> on physical computing and digital
          fabrication.
        </p>
        <p>
          My work has been published at top HCI and robotics conferences such as CHI, UIST, ASSETS,
          and IROS and has been featured in CNN, Business Insider, The Verge, CNET, Gizmodo, and
          Engadget among others.
        </p>
      </div>
      <SocialLinks variant="solid" class="about__social" />
      <p class="about__actions">
        <a class="button" href={contact}>
          Contact
        </a>
        <a class="button button--secondary" href={href(CV_PATH)}>
          CV
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .about__portrait {
    width: 200px;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: var(--surface);
  }

  /* <Picture> wraps the image in <picture>; size it so the image can fill the box. */
  .about__portrait :global(picture) {
    height: 100%;
  }

  .about__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__heading {
    margin-bottom: var(--space-3);
    font-size: var(--fs-h2);
  }

  .about__social {
    margin-top: var(--space-3);
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
  }

  @media (min-width: 640px) {
    .about__portrait {
      width: 280px;
    }
  }

  @media (min-width: 900px) {
    .about__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      align-items: center;
      gap: var(--space-6);
    }
    .about__portrait {
      width: 360px;
      justify-self: center;
    }
  }
</style>
