---
import { href } from '../lib/paths';

const nav = [
  { label: 'About', to: '/#about' },
  { label: 'Publications', to: '/#publications' },
  { label: 'Work', to: '/#projects' },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__name" href={href('/')}>
      Daniel Campos Zamora
    </a>
    <nav aria-label="Primary">
      <ul class="site-nav">
        {nav.map((item) => (
          <li>
            <a href={href(item.to)}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  /* Highlight the nav link of the section in view (home page only). The
     sections come after the header in the DOM, so wait for the parser. */
  (() => {
    const init = () => {
      const links = Array.from(document.querySelectorAll('.site-nav a[href*="#"]'));
      if (!links.length || !('IntersectionObserver' in window)) return;
      const targets = new Map();
      for (const a of links) {
        const id = (a.getAttribute('href') || '').split('#')[1];
        const el = id && document.getElementById(id);
        if (el) targets.set(el, a);
      }
      if (!targets.size) return;
      const visible = new Set();
      const update = () => {
        const top = Array.from(visible).sort(
          (a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top,
        )[0];
        for (const a of links) a.removeAttribute('aria-current');
        if (top) targets.get(top).setAttribute('aria-current', 'location');
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) visible.add(e.target);
            else visible.delete(e.target);
          }
          update();
        },
        { rootMargin: '-35% 0px -55% 0px' },
      );
      for (const el of targets.keys()) io.observe(el);
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
  }

  .site-header__name {
    font-size: clamp(1.15rem, 1rem + 0.9vw, 1.5rem);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--fs-sm);
    font-weight: var(--fw-regular);
  }

  .site-nav a {
    display: inline-block;
    padding-block: var(--space-1);
    text-decoration: none;
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur-fast) var(--ease);
  }

  .site-nav a:hover,
  .site-nav a[aria-current] {
    border-color: var(--accent);
  }

  @media (min-width: 640px) {
    .site-header__inner {
      flex-wrap: nowrap;
      padding-block: var(--space-4);
    }
  }
</style>
