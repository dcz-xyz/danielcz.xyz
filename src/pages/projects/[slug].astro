---
import { getCollection, getEntry, render } from 'astro:content';
import Demo from '../../components/Demo.astro';
import Project from '../../layouts/Project.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: projects[(i - 1 + projects.length) % projects.length],
      next: projects[(i + 1) % projects.length],
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const paperRef = project.data.links.paper;
const paper = paperRef ? await getEntry('publications', paperRef.id) : undefined;
---

<Project project={project} paper={paper} prev={prev} next={next}>
  <Content />
  {project.data.demo && <Demo name={project.data.demo} slot="demo" />}
</Project>
