{
  "name": "danielcz.xyz",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Personal research portfolio of Daniel Campos Zamora, built with Astro and deployed to GitHub Pages.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "budget": "node scripts/js-budget.mjs",
    "test:e2e": "playwright test",
    "shots:update": "playwright test tests/screenshots.spec.ts --update-snapshots all",
    "check:ci": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run budget",
    "check": "npm run check:ci && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "astro": "^7.3.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
